":: Define 16k ROM size with bankswitching\n  set romsize 16k\n\n  :: Standard minikernel setup for Text Minikernel\n  dim TextIndex = t\n\n  :: ==========================================\n  :: BANK 1: Main Logic & Game Loop\n  :: ==========================================\n  bank 1\n\n  :: Set initial colors\n  COLUPF = $1C\n  COLUP0 = $44\n  scorecolor = $0F\n\n  :: Index 0 points to \"HELLO WORLD \"\n  TextIndex = 0\n\nmainloop\n  :: Standard test sprite\n  player0:\n    %00111100\n    %01111110\n    %11000011\n    %11111111\n    %11000011\n    %01111110\n    %00111100\nend\n\n  :: Press joystick fire button to swap displayed text\n  if joy0fire then goto change_text\n\n  drawscreen\n  goto mainloop\n\nchange_text\n  :: Toggle between Index 0 (\"HELLO WORLD \") and Index 12 (\"BANK SWITCH \")\n  if TextIndex == 0 then TextIndex = 12 : goto debounce\n  if TextIndex == 12 then TextIndex = 0 : goto debounce\n\ndebounce\n  :: Wait for trigger release\n  if joy0fire then drawscreen : goto debounce\n  goto mainloop\n\n  :: ==========================================\n  :: BANK 2: Extra Bank\n  :: ==========================================\n  bank 2\n\n  :: Space for extra game logic, level maps, etc.\n\n  :: ==========================================\n  :: BANK 3: Extra Bank\n  :: ==========================================\n  bank 3\n\n  :: Space for graphics, audio routines, or data tables\n\n  :: ==========================================\n  :: BANK 4: Last Bank (Minikernel & Strings)\n  :: ==========================================\n  bank 4\n\n  :: Define text messages (12 characters each)\n  :: Index 0\n  data text_strings\n    __H, __E, __L, __L, __O, _sp, __W, __O, __R, __L, __D, _sp\n    :: Index 12\n    __B, __A, __N, __K, _sp, __S, __W, __I, __T, __C, __H, _sp\n  end\n\n  :: Include font data and minikernel display driver\n  inline text12b.asm\n  inline text12a.asm"