<xml>
    <category name="Logic" colour="%{BKY_LOGIC_HUE}">
        <block type="controls_if"></block>
        <block type="controls_if">
            <mutation else="1"></mutation>
        </block>

        <block type="logic_compare"></block>
        <block type="logic_operation"></block>
        <block type="logic_negate"></block>
        <block type="logic_boolean"></block>
        <block type="logic_boolean">
            <field name="BOOL">FALSE</field>
        </block>
    </category>
    <category name="Loops" colour="%{BKY_LOOPS_HUE}">
        <block type="controls_repeat_ext">
            <value name="TIMES">
                <block type="math_number">
                    <field name="NUM">10</field>
                </block>
            </value>
        </block>
        <block type="controls_whileUntil"></block>

        <block type="wait_frames">
            <value name="FRAMES">
                <shadow type="math_number">
                    <field name="NUM">30</field>
                </shadow>
            </value>
        </block>

        <block type="controls_repeat_ext">
            <value name="TIMES">
                <block type="math_number">
                    <field name="NUM">30</field>
                </block>
            </value>
            <statement name="DO">
                <block type="draw_screen">
                    <next>
                        <block type="sprite_player0_change">
                            <field name="VAR">player0x</field>
                            <value name="DELTA">
                                <shadow type="math_number">
                                <field name="NUM">1</field>
                                </shadow>
                            </value>
                        </block>
                    </next>
                </block>
            </statement>
        </block>
    </category>
    <category name="Math" colour="%{BKY_MATH_HUE}">
        <block type="math_number">
            <field name="NUM">123</field>
        </block>
        <block type="math_arithmetic"></block>
        <block type="math_abs_set"></block>
    </category>
    <category name="Variables" custom="VARIABLE" colour="%{BKY_VARIABLES_HUE}">
    </category>
    <category name="Sprites" colour="red">

        <block type="sprite_player0_get"></block>
        <block type="sprite_player0_set">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_player0_change">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_player0_size" />
        <block type="sprite_player0_animation_select"></block>
        <block type="sprite_player0_animation_playback"></block>
        <block type="sprite_player0_rom_noise">
            <value name="OFFSET">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="HEIGHT">
                <shadow type="math_number">
                    <field name="NUM">8</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_player0_rom_noise_stop"></block>
        {{#if enablePlayer0SpriteColors}}
        <block type="sprite_player0_rainbow_colors">
            <value name="OFFSET">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_player0_rainbow_colors_stop"></block>
        {{/if}}
        <block type="sprite_player0_set">
            <field name="VAR">player0realcolor</field>
            <value name="VALUE">
                <shadow type="color_get">
                    <field name="COLOR">212</field>
                </shadow>
            </value>
        </block>

        <block type="sprite_player1_get"></block>
        <block type="sprite_player1_set">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_player1_change">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_player1_size" />
        <block type="sprite_player1_animation_select"></block>
        <block type="sprite_player1_animation_playback"></block>
        <block type="sprite_player1_rom_noise">
            <value name="OFFSET">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="HEIGHT">
                <shadow type="math_number">
                    <field name="NUM">8</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_player1_rom_noise_stop"></block>
        {{#if enablePlayer1SpriteColors}}
        <block type="sprite_player1_rainbow_colors">
            <value name="OFFSET">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_player1_rainbow_colors_stop"></block>
        {{/if}}
        <block type="sprite_player1_set">
            <field name="VAR">player1realcolor</field>
            <value name="VALUE">
                <shadow type="color_get">
                    <field name="COLOR">250</field>
                </shadow>
            </value>
        </block>

        <block type="sprite_missile0_get"></block>
        <block type="sprite_missile0_set">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_missile0_change">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_missile0_size" />
        <block type="sprite_missile0_fire">
            <value name="X">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="Y">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="ANGLE">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>

        <block type="sprite_missile1_get"></block>
        <block type="sprite_missile1_set">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_missile1_change">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_missile1_size" />
        <block type="sprite_missile1_fire">
            <value name="X">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="Y">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="ANGLE">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>

        <block type="sprite_ball_get"></block>
        <block type="sprite_ball_set">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="sprite_ball_change">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>

        <block type="object_seek_to">
            <value name="X">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="Y">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="SPEED">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>

        <block type="object_seek_arrived"></block>

        <block type="sprite_priority_set"></block>

    </category>
    <category name="Input" colour="green">
        <block type="input_joy0_get"></block>
        <block type="input_joy1_get"></block>
        <block type="input_joy0_direction8"></block>
        <block type="input_joy1_direction8"></block>
        <block type="input_keypad0_get"></block>
        <block type="input_keypad1_get"></block>
        <block type="input_keypad0_any_pressed"></block>
        <block type="input_keypad1_any_pressed"></block>
        <block type="input_keypad0_id_get"></block>
        <block type="input_keypad1_id_get"></block>

        <block type="collision_get"></block>
        <block type="collision_check_position"></block>
        <block type="input_console_switch_get"></block>
        <block type="color_get"></block>

        <block type="distance_x_get"></block>
        <block type="distance_y_get"></block>
        <block type="distance_x_to_point_get">
            <value name="POINT">
                <shadow type="math_number">
                <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
        <block type="distance_y_to_point_get">
            <value name="POINT">
                <shadow type="math_number">
                <field name="NUM">0</field>
                </shadow>
            </value>
        </block>

        <block type="random_seed_set">
            <value name="SEED">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
        <block type="random_get"></block>
        <block type="random_range_get"></block>

        <block type="bit_get"></block>
        <block type="bit_set">
            <value name="VALUE">
                <shadow type="logic_boolean">
                    <field name="BOOL">TRUE</field>
                </shadow>
            </value>
        </block>
        <block type="system_variable_get"></block>

        <block type="sprite_player0_set">
            <field name="VAR">player0x</field>
            <value name="VALUE">
                <shadow type="math_number">
                <field name="NUM">1</field>
                </shadow>
                <block type="random_range_get">
                <field name="RAND_CODE">(rand/4) + 1</field>
                </block>
            </value>
        </block>

        <block type="sprite_player1_set">
            <field name="VAR">player1y</field>
            <value name="VALUE">
                <shadow type="math_number">
                <field name="NUM">1</field>
                </shadow>
                <block type="random_range_get">
                <field name="RAND_CODE">(rand/8)</field>
                </block>
            </value>
        </block>
    </category>
    <category name="Background" colour="#ffa500">
        <block type="background_select"></block>
        <block type="background_set">
            <value name="VALUE">
                <shadow type="background_select">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="background_set_select"></block>
        <block type="background_set_color">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">20</field>
                </shadow>
            </value>
        </block>
        <block type="background_set_color">
            <field name="VAR">COLUBK</field>
            <value name="VALUE">
                <shadow type="color_get">
                    <field name="COLOR">146</field>
                </shadow>
            </value>
        </block>
        <block type="background_get_color"></block>
        <block type="background_fade_to">
            <field name="VAR">COLUBK</field>
            <value name="VALUE">
                <shadow type="color_get">
                    <field name="COLOR">158</field>
                </shadow>
            </value>
            <value name="FRAMES">
                <shadow type="math_number">
                    <field name="NUM">30</field>
                </shadow>
            </value>
        </block>
        <block type="background_fade_finished"></block>
        <block type="background_fade_active"></block>
        <block type="background_get_pixel">
            <value name="X">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="Y">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="background_change_pixel">
            <value name="X">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="Y">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="background_change_hv_line">
            <value name="LENGTH">
                <shadow type="math_number">
                    <field name="NUM">4</field>
                </shadow>
            </value>
            <value name="X">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
            <value name="Y">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="background_scroll">
        </block>
        <block type="background_get_resolution"></block>
        <block type="background_clear"></block>
        <block type="draw_screen"></block>
    </category>
    <category name="Score" colour="#f2691e">
        <block type="score_get"></block>
        <block type="score_set">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="score_change">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>

        <block type="score_color_get"></block>
        <block type="score_color_set">
            <value name="VALUE">
                <shadow type="color_get">
                    <field name="COLOR">146</field>
                </shadow>
            </value>
        </block>
        <block type="score_color_change">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="score_bk_color_set">
            <value name="VALUE">
                <shadow type="color_get">
                    <field name="COLOR">146</field>
                </shadow>
            </value>
        </block>
        <block type="score_fade_to">
            <value name="VALUE">
                <shadow type="color_get">
                    <field name="COLOR">146</field>
                </shadow>
            </value>
            <value name="FRAMES">
                <shadow type="math_number">
                    <field name="NUM">30</field>
                </shadow>
            </value>
        </block>
        <block type="score_fade_finished"></block>

        <block type="score_digit_get"></block>
        <block type="score_digit_set">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
        <block type="score_digit_change">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>

        <block type="score_bar_get"></block>
        <block type="score_bar_set">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">255</field>
                </shadow>
            </value>
        </block>
        <block type="score_bar_change">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="score_bar_set_health">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">8</field>
                </shadow>
            </value>
        </block>
        <block type="score_bar_set_lives">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">3</field>
                </shadow>
            </value>
        </block>
        <block type="score_bar_change_health">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="score_bar_change_lives">
            <value name="DELTA">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
    </category>
    <category name="Data" colour="rgb(121, 85, 72)">
        <block type="data_get_element">
            <value name="INDEX">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
        <block type="data_get_bit">
            <value name="INDEX">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
        <block type="data_get_element_by_id">
            <value name="INDEX">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
        <block type="data_get_bit_by_id">
            <value name="INDEX">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
    </category>
    <category name="Text" colour="#3F51B5">
        <block type="text_minikernel_show"></block>
        <block type="text_minikernel_show_named"></block>
        <block type="text_minikernel_show_by_id">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="text_minikernel_show_scroll">
            <value name="SCROLL_SPEED">
                <shadow type="math_number">
                    <field name="NUM">20</field>
                </shadow>
            </value>
            <value name="SCROLL_PAUSE">
                <shadow type="math_number">
                    <field name="NUM">30</field>
                </shadow>
            </value>
        </block>
        <block type="text_minikernel_show_named_scroll">
            <value name="SCROLL_SPEED">
                <shadow type="math_number">
                    <field name="NUM">20</field>
                </shadow>
            </value>
            <value name="SCROLL_PAUSE">
                <shadow type="math_number">
                    <field name="NUM">30</field>
                </shadow>
            </value>
        </block>
        <block type="text_minikernel_show_by_id_scroll">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
            <value name="SCROLL_SPEED">
                <shadow type="math_number">
                    <field name="NUM">20</field>
                </shadow>
            </value>
            <value name="SCROLL_PAUSE">
                <shadow type="math_number">
                    <field name="NUM">30</field>
                </shadow>
            </value>
        </block>
        <block type="text_minikernel_set_color">
            <value name="VALUE">
                <shadow type="color_get">
                    <field name="COLOR">15</field>
                </shadow>
            </value>
        </block>
        <block type="text_minikernel_fade_to">
            <value name="VALUE">
                <shadow type="color_get">
                    <field name="COLOR">15</field>
                </shadow>
            </value>
            <value name="FRAMES">
                <shadow type="math_number">
                    <field name="NUM">30</field>
                </shadow>
            </value>
        </block>
        <block type="text_minikernel_fade_finished"></block>
        <block type="text_minikernel_scroll_control"></block>
        <block type="text_minikernel_scroll_at"></block>
        <block type="text_minikernel_clear"></block>
    </category>
    <category name="Sound" colour="rgb(156, 39, 176)">
        <block type="simple_sound_set"></block>
        <block type="soundfx_play"></block>
    </category>
    <category name="Music" colour="rgb(255, 87, 34)">
        <block type="music_play_song"></block>
        <block type="music_play_song_by_id">
            <value name="SONG_ID">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="music_stop_song"></block>
        <block type="music_pause_song"></block>
        <block type="music_unpause_song"></block>
        <block type="music_song_stopped"></block>
        <block type="music_song_stopped_by_id"></block>
        <block type="music_song_stopped_by_number">
            <value name="SONG_ID">
                <shadow type="math_number">
                    <field name="NUM">1</field>
                </shadow>
            </value>
        </block>
        <block type="music_sequence_chip_finished"></block>
        <block type="music_sequence_chip_finished_by_id"></block>
        <block type="music_sequence_chip_finished_current_song"></block>
        <block type="music_note_played"></block>
        <block type="music_note_played_by_id"></block>
    </category>
    <category name="Event" colour="rgb(39, 176, 176)">

        <block type="event_block"></block>
        <block type="event_change_state">
            <field name="STATE">gameover</field>
        </block>

        <block type="event_block">
          <field name="EVENT">title_update</field>
          <statement name="DO">
            <block type="controls_if">
              <value name="IF0">
                <block type="input_joy0_get">
                  <field name="VAR">joy0fire</field>
                </block>
              </value>
              <statement name="DO0">
                <block type="event_change_state">
                  <field name="STATE">gameplay</field>
                </block>
              </statement>
            </block>
          </statement>
        </block>

        <block type="event_frame_even_odd"></block>
        <block type="event_frame_every_n"></block>
        <block type="event_run_once"></block>

        <block type="subroutine_define"></block>
        <block type="subroutine_call"></block>

        <block type="function_define"></block>
        <block type="function_param_get"></block>
        <block type="function_return">
            <value name="VALUE">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
        <block type="function_call_statement">
            <value name="ARG1">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>
        <block type="function_call">
            <value name="ARG1">
                <shadow type="math_number">
                    <field name="NUM">0</field>
                </shadow>
            </value>
        </block>

        <block type="event_comment"></block>
        <block type="event_comment_wrapper"></block>
    </category>
    <category name="Examples" colour="cyan">

        {{{blocklyToolboxPlayer0Movement}}}

        {{{blocklyToolboxPlayer1Movement}}}

        {{{blocklyToolboxBallMovement}}}

        {{{blocklyToolboxBackground}}}

        {{{blocklyToolboxExampleEvent}}}

    </category>
</xml>
